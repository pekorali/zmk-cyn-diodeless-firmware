/*
 * sofle_diodless.keymap — 4 слоя, по 72 биндинга (совпадает с
 * порядком map в sofle_diodless.dtsi: 6 логических строк x 12 столбцов).
 *
 *  позиция 0..5   левая  колонка 0..5 (внешний край -> центр)
 *  позиция 6..11  правая колонка 0..5 (центр -> внешний край)
 *
 *  ┌──────────────────────────────────────┬──────────────────────────────────────┐
 *  │  `   1   2   3   4   5              │  6   7   8   9   0   —            │
 *  │ ESC  Q   W   E   R   T              │  Y   U   I   O   P   BACKSPACE    │
 *  │ TAB  A   S   D   F   G   ★ home     │  H   J   K   L   ;   '     ★ home │
 *  │ SFT  Z   X   C   V   B              │  N   M   ,   .   /   SHIFT       │
 *  │ —   ALT CTRL  —   —   —             │  —   —   —  CTRL ALT  —           │
 *  │ GUI LOW ENT ENC — —    🔴 direct     │  —   —  SPC RAISE GUI ENC 🔴 direct │
 *  └──────────────────────────────────────┴──────────────────────────────────────┘
 *
 *  Слои:  0 DEFAULT, 1 LOWER, 2 RAISE, 3 ADJUST
 *  ADJUST включается удержанием LOWER + RAISE (conditional_layers)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define ADJUST  3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* ═══════════════════════════════════════════════════════════
         *  LAYER 0 — DEFAULT
         * ═══════════════════════════════════════════════════════════ */
        default_layer {
            display-name = "QWERTY";
            bindings = <
/* pos  0 */ &kp GRAVE    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5       &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &none
/* pos 12 */ &kp ESC      &kp Q        &kp W        &kp E        &kp R        &kp T        &kp Y        &kp U        &kp I        &kp O        &kp P        &kp BSPC
/* pos 24 */ &kp TAB      &kp A        &kp S        &kp D        &kp F        &kp G        &kp H        &kp J        &kp K        &kp L        &kp SEMI     &kp SQT
/* pos 36 */ &kp LSHFT    &kp Z        &kp X        &kp C        &kp V        &kp B        &kp N        &kp M        &kp COMMA    &kp DOT      &kp FSLH     &kp RSHFT
/* pos 48 */ &none        &kp LALT     &kp LCTRL    &none        &none        &none        &none        &none        &none        &kp RCTRL    &kp RALT     &none
/* pos 60 */ &kp LGUI     &mo LOWER    &kp RET      &kp C_MUTE   &none        &none        &none        &none        &kp SPACE    &mo RAISE    &kp RGUI     &kp C_MUTE
            >;

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
                &inc_dec_kp PG_UP    PG_DN
            >;
        };

        /* ═══════════════════════════════════════════════════════════
         *  LAYER 1 — LOWER  (символы, F1..F12, навигация)
         * ═══════════════════════════════════════════════════════════ */
        lower_layer {
            display-name = "Lower";
            bindings = <
/* pos  0 */ &trans       &kp F1       &kp F2       &kp F3       &kp F4       &kp F5       &kp F6       &kp F7       &kp F8       &kp F9       &kp F10      &kp F11
/* pos 12 */ &kp GRAVE    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5       &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &kp F12
/* pos 24 */ &trans       &kp EXCL     &kp AT       &kp HASH     &kp DLLR     &kp PRCNT    &kp CARET    &kp AMPS     &kp ASTRK    &kp LPAR     &kp RPAR     &kp PIPE
/* pos 36 */ &trans       &kp EQUAL    &kp MINUS    &kp PLUS     &kp LBRC     &kp RBRC     &kp LBKT     &kp RBKT     &kp SEMI     &kp COLON    &kp BSLH     &trans
/* pos 48 */ &none        &kp LALT     &kp LCTRL    &none        &none        &none        &none        &none        &none        &kp RCTRL    &kp RALT     &none
/* pos 60 */ &kp LGUI     &trans       &kp RET      &trans       &none        &none        &none        &none        &kp SPACE    &mo ADJUST   &kp RGUI     &trans
            >;

            sensor-bindings = <
                &inc_dec_kp C_BRI_DN C_BRI_UP
                &inc_dec_kp C_PREV   C_NEXT
            >;
        };

        /* ═══════════════════════════════════════════════════════════
         *  LAYER 2 — RAISE  (BT, курсоры, clipboard, caps)
         * ═══════════════════════════════════════════════════════════ */
        raise_layer {
            display-name = "Raise";
            bindings = <
/* pos  0 */ &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans       &trans       &trans       &trans       &trans       &trans
/* pos 12 */ &trans       &kp INS      &kp PSCRN    &kp K_CMENU  &trans       &trans       &kp PG_UP    &trans       &kp UP       &trans       &trans       &trans
/* pos 24 */ &trans       &kp LALT     &kp LCTRL    &kp LSHFT    &trans       &kp CLCK     &kp PG_DN    &kp LEFT     &kp DOWN     &kp RIGHT    &kp DEL      &kp BSPC
/* pos 36 */ &trans       &kp K_UNDO   &kp K_CUT    &kp K_COPY   &kp K_PASTE  &trans       &trans       &trans       &trans       &trans       &trans       &trans
/* pos 48 */ &none        &kp LALT     &kp LCTRL    &none        &none        &none        &none        &none        &none        &kp RCTRL    &kp RALT     &none
/* pos 60 */ &kp LGUI     &mo ADJUST   &kp RET      &trans       &none        &none        &none        &none        &kp SPACE    &trans       &kp RGUI     &trans
            >;

            sensor-bindings = <
                &inc_dec_kp LEFT     RIGHT
                &inc_dec_kp DOWN     UP
            >;
        };

        /* ═══════════════════════════════════════════════════════════
         *  LAYER 3 — ADJUST  (bootloader, reset, Bluetooth)
         * ═══════════════════════════════════════════════════════════ */
        adjust_layer {
            display-name = "Adjust";
            bindings = <
/* pos  0 */ &bootloader  &sys_reset   &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans       &trans       &trans       &trans
/* pos 12 */ &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans
/* pos 24 */ &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans
/* pos 36 */ &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans
/* pos 48 */ &none        &kp LALT     &kp LCTRL    &none        &none        &none        &none        &none        &none        &kp RCTRL    &kp RALT     &none
/* pos 60 */ &trans       &trans       &kp RET      &trans       &none        &none        &none        &none        &kp SPACE    &trans       &trans       &trans
            >;
        };
    };
};