DT_COMPAT_ZMK_KSCAN_GPIO_MATRIX_HIZ := zmk,kscan-gpio-matrix-hiz

config ZMK_KSCAN_GPIO_MATRIX_HIZ
	bool
	default $(dt_compat_enabled,$(DT_COMPAT_ZMK_KSCAN_GPIO_MATRIX_HIZ))
	select GPIO
	select ZMK_KSCAN_GPIO_DRIVER
	help
	  GPIO matrix scanner for diodeless matrices. Unlike the stock
	  zmk,kscan-gpio-matrix driver, the outputs that are not being scanned
	  are put into a high-impedance state instead of being driven to the
	  inactive level, which removes the key ghosting of diodeless matrices
	  and gives full NKRO.
