DT_COMPAT_ZMK_KSCAN_GPIO_MATRIX_HIZ := zmk,kscan-gpio-matrix-hiz

config ZMK_KSCAN_GPIO_MATRIX_HIZ
	bool
	default $(dt_compat_enabled,$(DT_COMPAT_ZMK_KSCAN_GPIO_MATRIX_HIZ))
	select GPIO
	select ZMK_KSCAN_GPIO_DRIVER
	help
	  GPIO matrix scanner for diodeless matrices. Unlike the stock
	  zmk,kscan-gpio-matrix driver, the outputs that are not being scanned
	  are put into a high-impedance state instead of being driven to the
	  inactive level, which removes the key ghosting of diodeless matrices
	  and gives full NKRO.

config ZMK_KSCAN_GPIO_MATRIX_HIZ_GHOST_FILTER
	bool "Filter out ghost keys of a diodeless matrix"
	default y
	depends on ZMK_KSCAN_GPIO_MATRIX_HIZ
	help
	  In a matrix without diodes three keys forming an "L" shape create a
	  conducting path that makes a fourth key read as pressed even though
	  it is not. Such a "ghost" cannot be detected reliably: the sets
	  {W,S,D} and {W,S,D,E} produce exactly the same voltages on all
	  pins, so no digital scan can tell them apart.

	  With this option the driver picks the most plausible interpretation
	  instead of reporting every cell that reads as pressed: a cell that
	  only appeared because a chain of three pressed keys just got
	  completed is dropped, and keys that were already reported as
	  pressed are never dropped.

	  Turn this off to see the raw matrix (ghosts included).

config ZMK_KSCAN_GPIO_MATRIX_HIZ_STUCK_KEY_TIMEOUT_MS
	int "Force-release a key held continuously for this long (ms), 0 to disable"
	default 300000
	depends on ZMK_KSCAN_GPIO_MATRIX_HIZ
	range 0 2147483647
	help
	  A switch that gets mechanically stuck closed keeps its HID key
	  reported forever: it fills the USB/BLE report and repeats
	  characters.

	  With this option the driver reports the key released after it has
	  been continuously held for this many milliseconds and ignores the
	  switch until its contacts actually open again. The check runs on
	  every scan and cannot affect ordinary simultaneous key presses:
	  the threshold is minutes of continuously holding a single key.
	  Set to 0 to disable the protection (for example if a bound action
	  requires holding a key longer than the timeout).
